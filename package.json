{
  "name": "dsh-wolfram-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Connects a local Wolfram Mathematica kernel to DeepSeek Harness as an MCP tool server, configured from the Plugins UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "wolfram",
    "mathematica"
  ],
  "author": "FZZoooh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FZZoooh/dsh-wolfram-mcp.git"
  },
  "homepage": "https://github.com/FZZoooh/dsh-wolfram-mcp#readme",
  "bugs": {
    "url": "https://github.com/FZZoooh/dsh-wolfram-mcp/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
